# Copy this file to .env and fill in real values.
# .env itself is gitignored — never commit real secrets.

# --- Django ---
# Leave DJANGO_DEBUG unset (or True) for local dev. Set to False in
# production, and DJANGO_SECRET_KEY / DJANGO_ALLOWED_HOSTS become required.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=

# --- Database ---
# AMANGO_DB_ENGINE=mysql selects MySQL (the default); anything else falls
# back to local SQLite. AMANGO_DB_HOST=db targets the docker-compose MySQL
# service by its service name.
AMANGO_DB_ENGINE=mysql
AMANGO_DB_NAME=amangodevdb
AMANGO_DB_USER=root
AMANGO_DB_PASSWORD=allif123
AMANGO_DB_HOST=db
AMANGO_DB_PORT=3306

# --- MySQL container itself (docker-compose db service) ---
# Must match AMANGO_DB_PASSWORD above, since that's the account Django logs
# in as, and this is the password MySQL creates that account with.
MYSQL_ROOT_PASSWORD=allif123
