# Copy this file to .env and fill in real values.
# .env itself is gitignored — never commit real secrets.

# --- Django ---
# Leave DJANGO_DEBUG unset (or True) for local dev. Set to False in
# production, and DJANGO_SECRET_KEY / DJANGO_ALLOWED_HOSTS become required.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=

# --- Database ---
# AMANGO_DB_ENGINE selects the backend: postgresql (default), mysql, or
# anything else falls back to local SQLite. AMANGO_DB_HOST=db targets the
# docker-compose Postgres service by its service name.
AMANGO_DB_ENGINE=postgresql
AMANGO_DB_NAME=AMANGODB
AMANGO_DB_USER=postgres
AMANGO_DB_PASSWORD=change-me
AMANGO_DB_HOST=db
AMANGO_DB_PORT=5432
